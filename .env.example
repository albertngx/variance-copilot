# Copy to .env and adjust. All settings use the VC_ prefix (SPEC §24).
# Defaults shown are the built-in defaults; uncommented lines are what local dev needs.

VC_ENV=dev
VC_DATABASE_URL=postgresql+psycopg://vc_owner:localdev@localhost:5432/variance_copilot
VC_DB_PASSWORD=localdev

# LLM and embeddings
# VC_LLM_PROVIDER=openai
# VC_LLM_MODEL=
# VC_JUDGE_PROVIDER=
# VC_JUDGE_MODEL=
# VC_EMBEDDING_PROVIDER=
# VC_EMBEDDING_MODEL=
# VC_EMBEDDING_DIM=1024
# VC_AWS_REGION=eu-central-1
# VC_AZURE_OPENAI_ENDPOINT=
# VC_AZURE_OPENAI_DEPLOYMENT=

# Run limits (SPEC §12.3)
# VC_MAX_TURNS=8
# VC_MAX_TOOL_CALLS=12
# VC_MAX_COST_USD_PER_RUN=1.00

# Audit
# VC_STORE_LLM_CONTENT=true

# Authentication
# VC_AUTH_MODE=dev
# VC_OIDC_ISSUER=
# VC_OIDC_AUDIENCE=
# VC_OIDC_JWKS_URL=
VC_DEV_JWT_SECRET=change-me-local-only

# Replay and observability
# VC_REPLAY_MODE=off
VC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# VC_LOG_LEVEL=INFO

# MCP
# VC_MCP_HTTP_ENABLED=false
# VC_MCP_TRANSPORT=memory
# VC_MCP_SERVER_URL=
